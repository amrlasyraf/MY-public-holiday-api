{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "lib": ["ESNext", "DOM"],
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}
